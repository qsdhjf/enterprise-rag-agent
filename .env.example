# 外部 OpenAI 兼容大模型服务；复制本文件为 .env 后替换占位值。
LLM_BASE_URL=https://example.com/api/v1
LLM_MODEL=replace-with-model-name
LLM_API_KEY=replace-with-secret

# OpenSearch 索引配置。Docker Compose 启动时会把 URL 覆盖为容器服务名。
OPENSEARCH_URL=http://opensearch:9200
# 纯关键词/向量流程使用的默认索引。
OPENSEARCH_INDEX=enterprise-chunks-v1
# 同时保存文本字段与向量字段的混合检索索引。
OPENSEARCH_HYBRID_INDEX=enterprise-chunks-hybrid-v1

# 复用 OpenAI 接口协议访问宿主机上的 Ollama 嵌入模型。
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_MODEL=bge-m3
# Ollama 通常不校验密钥，但兼容客户端仍要求提供一个非空值。
EMBEDDING_API_KEY=ollama
# 必须与所选嵌入模型的输出维度及 OpenSearch 映射保持一致。
EMBEDDING_DIMENSIONS=1024
# BGE reranker served by Hugging Face Text Embeddings Inference.
# Use http://reranker:80 inside Compose and http://127.0.0.1:8081 locally.
RERANKER_BASE_URL=http://127.0.0.1:8081
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TIMEOUT_SECONDS=30
RERANKER_MAX_CANDIDATES=40
# true: a reranker outage stops retrieval; false: fall back to RRF.
RERANKER_REQUIRED=true
# Leave empty unless the reranker service is configured with an API key.
RERANKER_API_KEY=

# Live HTTP mode requires a separate server-owned identity file.
# Pass --identity-file .local/identities.json to enterprise-agent-serve.
# The UI defaults to demo only when explicitly launched with --mode demo.
AGENT_MAX_CONCURRENT=2

# Personal document storage; private files, not a chat memory feature.
# CLI --knowledge-dir overrides location. Use ONE web worker per directory.
AGENT_KNOWLEDGE_DIR=.local/knowledge
# Explicitly opt in via --enable-knowledge-model; default upload/search has no model calls.
AGENT_KNOWLEDGE_MODEL_ENABLED=0
# Authenticated deployment behind TLS proxy only; exact browser origin, no wildcard.
# AGENT_PUBLIC_ORIGIN=https://rag.example.org

# Personal vector logical-payload quotas and disk headroom, in bytes.
# Set these in the process/Compose environment. Offline demo does not auto-load .env.
AGENT_VECTOR_BYTES_LIMIT=536870912
AGENT_OWNER_VECTOR_BYTES_LIMIT=134217728
AGENT_MIN_FREE_BYTES=268435456
